set timeout=8
set default=0

insmod part_gpt
insmod fat
insmod ext2
insmod serial
insmod video
insmod video_bochs
insmod video_cirrus

set menu_color_normal=cyan/black
set menu_color_highlight=magenta/black

menuentry "Synth3x Environment v@VERSION@" {
    linux /boot/vmlinuz-linux loglevel=3 console=tty0 console=ttyS0,115200 acpi=force no_timer_check
    initrd /boot/initrd.img
}

menuentry "! Reboot" { reboot }
menuentry "! Shutdown" { halt }
